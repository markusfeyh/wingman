# Copy to .env and fill in. Never commit .env.
WINGMAN_TOKEN=            # any long random string; you type it once on your phone
ANTHROPIC_API_KEY=        # console.anthropic.com
OPENAI_API_KEY=           # alternative to Anthropic: used when ANTHROPIC_API_KEY is empty (or WINGMAN_LLM=openai)
# WINGMAN_LLM=openai                    # force a provider: anthropic | openai
# WINGMAN_OPENAI_MODEL_LIVE=gpt-5.5     # OpenAI models (defaults shown)
BRIGHTDATA_API_KEY=       # brightdata.com > Account settings > Users and API keys (an admin creates it; "User" permission is enough).
# Same Bright Data key for Business Search (people lookup; early access, else falls back to SERP), Scraper API, SERP, Web Unlocker
BRIGHTDATA_SERP_ZONE=serp_api1          # name of your SERP API zone
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1  # name of your Web Unlocker zone (personal sites on live lookups, generic event adapter)
# BRIGHTDATA_BUSINESS_SEARCH=false       # skip Business Search if your account isn't in its early access (it returns 403)
DEEPGRAM_API_KEY=         # optional: live transcript with speaker labels. Without it the browser's speech recognition is used
GITHUB_TOKEN=             # optional: raises GitHub API limit (gh auth token)
# WINGMAN_MODEL_LIVE=claude-haiku-5-5   # optional: faster live cards (default claude-opus-5-5)
# VAPID_PRIVATE_KEY=  VAPID_PUBLIC_KEY=  from `uv run python -m wingman.cli vapid` (optional push notifications)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
WINGMAN_EVENT=github-universe-2026
