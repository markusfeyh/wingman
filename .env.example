# Copy to .env and fill in. Never commit .env.
WINGMAN_TOKEN=            # any long random string; you type it once on your phone
ANTHROPIC_API_KEY=        # console.anthropic.com
BRIGHTDATA_API_KEY=       # brightdata.com > Account settings > API key
BRIGHTDATA_SERP_ZONE=serp_api1          # name of your SERP API zone
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1  # name of your Web Unlocker zone (generic event adapter only)
DEEPGRAM_API_KEY=         # optional: live transcript with speaker labels. Without it the browser's speech recognition is used
GITHUB_TOKEN=             # optional: raises GitHub API limit (gh auth token)
# WINGMAN_MODEL_LIVE=claude-haiku-5-5   # optional: faster live cards (default claude-opus-5-5)
# VAPID_PRIVATE_KEY=  VAPID_PUBLIC_KEY=  from `uv run python -m wingman.cli vapid` (optional push notifications)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
WINGMAN_EVENT=github-universe-2026
